# ═══════════════════════════════════════════════════════════════════════════════
# INTERVIEW OS — Environment Configuration (.env file)
# ═══════════════════════════════════════════════════════════════════════════════
# 
# Copy this file to .env and fill in your own values
# dotenv-safe validates that all keys are present (even if empty)
#
# IMPORTANT:
#  - NEVER commit real .env files to Git
#  - Use .env.local for local development overrides
#  - In production, set these via your hosting platform  (Render, Vercel, etc.)

# ─── Node Environment ─────────────────────────────────────────────────────────
# Options: development | production | test
NODE_ENV=development
PORT=8090

# ─── Frontend URL ─────────────────────────────────────────────────────────────
# Used for CORS, email verification links, password reset links
# Development: http://localhost:8080 (or your Vite port)
# Production: https://yourdomain.com
CLIENT_URL=http://localhost:8080

# ─── Database (MongoDB) ────────────────────────────────────────────────────────
# Format:
#  - Local:       mongodb://localhost:27017/interviewos
#  - Docker:      mongodb://mongo:27017/interviewos (docker-compose)
#  - Atlas Cloud: mongodb+srv://user:pass@cluster.mongodb.net/interviewos
MONGODB_URI=mongodb://localhost:27017/interviewos

# ─── Authentication (JWT) ──────────────────────────────────────────────────────
# These should be strong random strings in production!
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Access token secret (15 min expiry)
JWT_ACCESS_SECRET=interviewos_access_secret_bharat_2026

# Access token expiry duration
JWT_ACCESS_EXPIRES=15m

# Refresh token secret (7 days expiry, stored in httpOnly cookie)
JWT_REFRESH_SECRET=interviewos_refresh_secret_bharat_2026

# Refresh token expiry duration
JWT_REFRESH_EXPIRES=7d

# Invite token secret (24 hr expiry, single-use for room invite links)
INVITE_TOKEN_SECRET=interviewos_invite_secret_bharat_2026

# ─── OAuth 2.0 (Google Sign-In) ────────────────────────────────────────────────
# Get credentials from: https://console.cloud.google.com
# Set OAuth 2.0 redirect URIs:
#  - http://localhost:5000/api/v1/auth/google/callback (local)
#  - https://yourdomain.com/api/v1/auth/google/callback (prod)

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ─── Email Service ────────────────────────────────────────────────────────────
# Choose ONE:
#  Option 1: SendGrid (production recommended)
#  Option 2: Nodemailer Ethereal (development test emails)

# SendGrid API key
# Get from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=

# Sender email address (must be verified in SendGrid)
FROM_EMAIL=noreply@interviewos.io

# ─── File Uploads (Cloudinary) ─────────────────────────────────────────────────
# Used for user avatars, resume uploads, screenshots
# Get credentials from: https://cloudinary.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Code Execution (Judge0) ───────────────────────────────────────────────────
# Sandboxed code execution for interview testing
# Hosted service: https://judge0.com/
# Free tier: judge0-ce.p.rapidapi.com

JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=

# ─── AI Services ───────────────────────────────────────────────────────────────
# Used for:
#  - AI interviewer question generation
#  - Code review analysis
#  - Hint generation
#  - Post-interview performance reports

# OpenAI API key (GPT-4 / GPT-3.5-turbo)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Groq API key (faster, cheaper alternative to OpenAI)
# Get from: https://console.groq.com
GROQ_API_KEY=

# ─── WebRTC (TURN/STUN Servers) ────────────────────────────────────────────────
# For peer-to-peer video connectivity when direct connection fails
# Free services: stun.l.google.com, stun.services.mozilla.com
# Paid: Twilio TURN, CoTurn server

TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ─── Stripe Billing ────────────────────────────────────────────────────────────
# Subscription management, pricing plans, webhooks
# Get from: https://stripe.com/docs

STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Redis (Optional but Recommended) ──────────────────────────────────────────
# Used for:
#  - Session storage
#  - Socket.IO adapter (for multi-server deployments)
#  - Rate limiting
#  - Caching

# Local Redis:      redis://localhost:6379
# Redis Cloud:      redis://:password@host:port
# Docker:           redis://redis:6379
REDIS_URL=redis://localhost:6379

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
# IP-based rate limiting to prevent abuse

# Time window in milliseconds (default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Max requests per IP per window (default: 100)
RATE_LIMIT_MAX=100

# ─── Feature Flags & Configuration ────────────────────────────────────────────
# Enable/disable features or change thresholds

# Proctoring settings
PROCTORING_ENABLED=true
MAX_TAB_SWITCHES_ALLOWED=3
MAX_COPY_PASTE_ATTEMPTS=5

# AI Interviewer feature
AI_INTERVIEWER_ENABLED=true
AI_PROVIDER=openai  # Options: openai | groq

# ─── Logging ───────────────────────────────────────────────────────────────────
# Winston logging configuration

LOG_LEVEL=info  # Options: error | warn | info | debug | silly
LOG_FILE_DIR=./logs

# ═══════════════════════════════════════════════════════════════════════════════
# DEPLOYMENT-SPECIFIC CONFIGS
# ═══════════════════════════════════════════════════════════════════════════════

# ─── For Render.com (Backend) ──────────────────────────────────────────────────
# Build command: npm install
# Start command: npm run start
# Environment: production
# Important: Set NODE_ENV=production on Render dashboard

# ─── For Vercel (Frontend) ─────────────────────────────────────────────────────
# Build command: npm run build
# Output directory: dist
# Environment: production
# Important: Add VITE_API_URL=<your-backend-url>

# ─── GitHub Actions CI/CD ──────────────────────────────────────────────────────
# Add these secrets to: https://github.com/your-repo/settings/secrets
# Then reference in workflows: ${{ secrets.SENDGRID_API_KEY }}
